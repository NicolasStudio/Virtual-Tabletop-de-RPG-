// Tabletop VTT — modelo de dados.
// O servidor é a fonte da verdade: notas privadas, fog e permissões vivem aqui
// e nunca são expostas ao cliente sem checagem de papel/propriedade.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Contas
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  isAdmin      Boolean  @default(false)
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  memberships        CampaignMember[]
  ownedCampaigns     Campaign[]           @relation("CampaignOwner")
  diceRolls          DiceRoll[]
  chatMessages       ChatMessage[]
  characters         Character[]
  auditLogs          AuditLog[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // nunca guardamos o token em claro
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Campanhas e salas
// ---------------------------------------------------------------------------

enum CampaignRole {
  GM
  PLAYER
  SPECTATOR
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  system      String   @default("generic") // identificador do sistema de RPG (não acopla a app a um ruleset)
  ownerId     String
  activeSceneId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User             @relation("CampaignOwner", fields: [ownerId], references: [id])
  members     CampaignMember[]
  invites     InviteCode[]
  folders     AssetFolder[]
  scenes      Scene[]
  characters  Character[]
  chatMessages ChatMessage[]
  encounters  CombatEncounter[]
  bestiary    BestiaryEntry[]
  assets      Asset[]

  @@index([ownerId])
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String
  userId     String
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
}

model InviteCode {
  id         String       @id @default(cuid())
  campaignId String
  code       String       @unique
  role       CampaignRole @default(PLAYER)
  maxUses    Int?         // null = ilimitado
  uses       Int          @default(0)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Organização em pastas (biblioteca da campanha)
// ---------------------------------------------------------------------------

// Que tipo de conteúdo uma pasta agrupa. Mantido como string-enum para o front
// poder exibir ícones/rótulos distintos (Cenas, Mapas, Tokens, Itens).
enum FolderKind {
  SCENE   // cenas (cenário + grade)
  MAP     // mapas-overlay reutilizáveis
  TOKEN   // tokens: personagens, monstros, npcs
  ITEM    // itens / drops
}

// Pasta da biblioteca da campanha. parentId permite subpastas
// (ex.: Tokens → Monstros). O escopo é sempre uma campanha.
model AssetFolder {
  id         String     @id @default(cuid())
  campaignId String
  kind       FolderKind
  name       String
  parentId   String?    // null = pasta raiz do seu kind
  order      Int        @default(0)
  createdAt  DateTime   @default(now())

  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parent     AssetFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   AssetFolder[] @relation("FolderTree")
  scenes     Scene[]
  tokens     Token[]
  assets     Asset[]

  @@index([campaignId, kind])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Mapas / cenas
// ---------------------------------------------------------------------------

enum GridType {
  SQUARE
  HEX
  NONE
}

model Scene {
  id          String   @id @default(cuid())
  campaignId  String
  folderId    String?  // pasta de organização (kind=SCENE)
  name        String
  backgroundAssetId String?
  width       Int      @default(1920) // px da cena
  height      Int      @default(1080)
  gridType    GridType @default(SQUARE)
  gridSize    Int      @default(70)   // px por célula
  gridColor   String   @default("#000000")
  scale       Float    @default(1)    // unidades de jogo por célula (ex.: 1.5m)
  layers      Json     @default("[]") // ordenação/visibilidade de camadas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  folder      AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tokens      Token[]
  fogRegions  FogRegion[]
  fog         SceneFog?
  overlays    MapOverlay[]

  @@index([campaignId])
  @@index([folderId])
}

// Mapa-overlay: uma imagem posicionada SOBRE a cena (o cenário é o fundo fixo;
// o mapa vai por cima e pode ser esticado/movido — só pelo GM). Várias por cena,
// ordenadas por `order`. Fica entre o fundo (cena) e os tokens/itens no z-order.
model MapOverlay {
  id         String   @id @default(cuid())
  sceneId    String
  folderId   String?  // pasta de organização (kind=MAP) na biblioteca
  assetId    String?  // asset de imagem (opcional se usar imageUrl direto)
  imageUrl   String?  // URL resolvida da imagem do mapa
  name       String   @default("Mapa")
  x          Float    @default(0)
  y          Float    @default(0)
  width      Float    @default(1920)
  height     Float    @default(1080)
  rotation   Float    @default(0)
  opacity    Float    @default(1)
  order      Int      @default(0)
  isLocked   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scene      Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

model Asset {
  id         String   @id @default(cuid())
  campaignId String
  folderId   String?  // pasta de organização na biblioteca
  uploaderId String?
  kind       String   // "image" | "audio" | "handout" | ...
  category   String?  // classificação de uso: "scene" | "map" | "token" | "item"
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String   // chave no storage S3-compatível / caminho local
  createdAt  DateTime @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  folder     AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([folderId])
}

// ---------------------------------------------------------------------------
// Tokens
// ---------------------------------------------------------------------------

// Subtipo de um token, usado para os subgrupos da biblioteca
// (Personagens / Monstros / NPCs / Itens-drop).
enum TokenKind {
  CHARACTER
  MONSTER
  NPC
  ITEM
}

model Token {
  id          String   @id @default(cuid())
  sceneId     String
  folderId    String?  // pasta de organização (kind=TOKEN/ITEM)
  kind        TokenKind @default(CHARACTER)
  characterId String?  // vínculo opcional com uma ficha
  ownerUserId String?  // quem controla este token (null = só GM)
  name        String
  imageAssetId String?
  imageUrl    String?  // URL direta da imagem (cache do asset para render rápido)
  x           Float    @default(0)
  y           Float    @default(0)
  width       Float    @default(70)
  height      Float    @default(70)
  rotation    Float    @default(0)
  layer       String   @default("tokens")
  isLocked    Boolean  @default(false)
  isHidden    Boolean  @default(false) // visível só para o GM
  groupId     String?
  // vida/recursos rápidos para a barra do token (a ficha completa fica em Character)
  stats       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scene       Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  folder      AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([sceneId])
}

// ---------------------------------------------------------------------------
// Fog of war / visibilidade (autoritativo no servidor)
// ---------------------------------------------------------------------------

model FogRegion {
  id        String   @id @default(cuid())
  sceneId   String
  revealed  Boolean  @default(false) // true = área revelada aos jogadores
  polygon   Json     // lista de pontos [{x,y}]
  createdAt DateTime @default(now())

  scene     Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

// Névoa de guerra por CÉLULAS (modelo A): um registro por cena.
// revealedCells = lista de "col,row" reveladas. Quando enabled=true e uma
// célula NÃO está revelada, ela é névoa (opaca para jogador, translúcida p/ GM).
model SceneFog {
  id            String   @id @default(cuid())
  sceneId       String   @unique
  enabled       Boolean  @default(false)
  revealedCells Json     @default("[]")
  updatedAt     DateTime @updatedAt

  scene         Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Personagens / fichas (multi-sistema via JSON tipado em packages/shared)
// ---------------------------------------------------------------------------

model Character {
  id          String   @id @default(cuid())
  campaignId  String
  ownerUserId String?
  name        String
  system      String   @default("generic")
  // ficha completa como documento flexível; o schema por sistema vive em shared
  sheet       Json     @default("{}")
  // notas privadas: nunca enviadas a quem não é dono nem GM
  privateNotes String  @default("")
  avatarAssetId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner       User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  tokens      Token[]

  @@index([campaignId])
  @@index([ownerUserId])
}

// ---------------------------------------------------------------------------
// Dados / rolagens
// ---------------------------------------------------------------------------

enum RollVisibility {
  PUBLIC   // todos veem
  GM       // só o GM
  PRIVATE  // só quem rolou
}

model DiceRoll {
  id         String         @id @default(cuid())
  campaignId String
  userId     String
  formula    String         // ex.: "2d20kh1+5"
  result     Int
  breakdown  Json           // dados individuais, modificadores, vantagem/desvantagem
  visibility RollVisibility @default(PUBLIC)
  createdAt  DateTime       @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

model ChatMessage {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String
  body        String
  toUserId    String?  // mensagem privada (whisper)
  rollId      String?  // mensagem que carrega uma rolagem
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Combate
// ---------------------------------------------------------------------------

model CombatEncounter {
  id          String   @id @default(cuid())
  campaignId  String
  sceneId     String?
  name        String   @default("Combate")
  round       Int      @default(0)
  turnIndex   Int      @default(0)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  combatants  CombatCombatant[]

  @@index([campaignId])
}

model CombatCombatant {
  id          String   @id @default(cuid())
  encounterId String
  tokenId     String?
  characterId String?
  name        String
  initiative  Float    @default(0)
  order       Int      @default(0)
  hp          Int      @default(0)
  maxHp       Int      @default(0)
  conditions  Json     @default("[]")
  isNpc       Boolean  @default(false)

  encounter   CombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
}

// ---------------------------------------------------------------------------
// Bestiário / compêndio
// ---------------------------------------------------------------------------

model BestiaryEntry {
  id          String   @id @default(cuid())
  campaignId  String?  // null = entrada global/compartilhada
  kind        String   // "creature" | "npc" | "item" | "spell" | "ability"
  name        String
  system      String   @default("generic")
  data        Json     @default("{}")
  tags        String[] @default([])
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())

  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Auditoria
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}
