// Tabletop VTT — modelo de dados.
// O servidor é a fonte da verdade: notas privadas, fog e permissões vivem aqui
// e nunca são expostas ao cliente sem checagem de papel/propriedade.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Contas
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  isAdmin      Boolean  @default(false)
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  memberships        CampaignMember[]
  ownedCampaigns     Campaign[]           @relation("CampaignOwner")
  diceRolls          DiceRoll[]
  chatMessages       ChatMessage[]
  characters         Character[]
  auditLogs          AuditLog[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // nunca guardamos o token em claro
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Campanhas e salas
// ---------------------------------------------------------------------------

enum CampaignRole {
  GM
  PLAYER
  SPECTATOR
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  system      String   @default("generic") // identificador do sistema de RPG (não acopla a app a um ruleset)
  ownerId     String
  activeSceneId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User             @relation("CampaignOwner", fields: [ownerId], references: [id])
  members     CampaignMember[]
  invites     InviteCode[]
  scenes      Scene[]
  characters  Character[]
  chatMessages ChatMessage[]
  encounters  CombatEncounter[]
  bestiary    BestiaryEntry[]
  assets      Asset[]

  @@index([ownerId])
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String
  userId     String
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
}

model InviteCode {
  id         String       @id @default(cuid())
  campaignId String
  code       String       @unique
  role       CampaignRole @default(PLAYER)
  maxUses    Int?         // null = ilimitado
  uses       Int          @default(0)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Mapas / cenas
// ---------------------------------------------------------------------------

enum GridType {
  SQUARE
  HEX
  NONE
}

model Scene {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  backgroundAssetId String?
  width       Int      @default(1920) // px da cena
  height      Int      @default(1080)
  gridType    GridType @default(SQUARE)
  gridSize    Int      @default(70)   // px por célula
  gridColor   String   @default("#000000")
  scale       Float    @default(1)    // unidades de jogo por célula (ex.: 1.5m)
  layers      Json     @default("[]") // ordenação/visibilidade de camadas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tokens      Token[]
  fogRegions  FogRegion[]

  @@index([campaignId])
}

model Asset {
  id         String   @id @default(cuid())
  campaignId String
  uploaderId String?
  kind       String   // "image" | "audio" | "handout" | ...
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String   // chave no storage S3-compatível / caminho local
  createdAt  DateTime @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Tokens
// ---------------------------------------------------------------------------

model Token {
  id          String   @id @default(cuid())
  sceneId     String
  characterId String?  // vínculo opcional com uma ficha
  ownerUserId String?  // quem controla este token (null = só GM)
  name        String
  imageAssetId String?
  x           Float    @default(0)
  y           Float    @default(0)
  width       Float    @default(70)
  height      Float    @default(70)
  rotation    Float    @default(0)
  layer       String   @default("tokens")
  isLocked    Boolean  @default(false)
  isHidden    Boolean  @default(false) // visível só para o GM
  groupId     String?
  // vida/recursos rápidos para a barra do token (a ficha completa fica em Character)
  stats       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scene       Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([sceneId])
}

// ---------------------------------------------------------------------------
// Fog of war / visibilidade (autoritativo no servidor)
// ---------------------------------------------------------------------------

model FogRegion {
  id        String   @id @default(cuid())
  sceneId   String
  revealed  Boolean  @default(false) // true = área revelada aos jogadores
  polygon   Json     // lista de pontos [{x,y}]
  createdAt DateTime @default(now())

  scene     Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

// ---------------------------------------------------------------------------
// Personagens / fichas (multi-sistema via JSON tipado em packages/shared)
// ---------------------------------------------------------------------------

model Character {
  id          String   @id @default(cuid())
  campaignId  String
  ownerUserId String?
  name        String
  system      String   @default("generic")
  // ficha completa como documento flexível; o schema por sistema vive em shared
  sheet       Json     @default("{}")
  // notas privadas: nunca enviadas a quem não é dono nem GM
  privateNotes String  @default("")
  avatarAssetId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner       User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  tokens      Token[]

  @@index([campaignId])
  @@index([ownerUserId])
}

// ---------------------------------------------------------------------------
// Dados / rolagens
// ---------------------------------------------------------------------------

enum RollVisibility {
  PUBLIC   // todos veem
  GM       // só o GM
  PRIVATE  // só quem rolou
}

model DiceRoll {
  id         String         @id @default(cuid())
  campaignId String
  userId     String
  formula    String         // ex.: "2d20kh1+5"
  result     Int
  breakdown  Json           // dados individuais, modificadores, vantagem/desvantagem
  visibility RollVisibility @default(PUBLIC)
  createdAt  DateTime       @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

model ChatMessage {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String
  body        String
  toUserId    String?  // mensagem privada (whisper)
  rollId      String?  // mensagem que carrega uma rolagem
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Combate
// ---------------------------------------------------------------------------

model CombatEncounter {
  id          String   @id @default(cuid())
  campaignId  String
  sceneId     String?
  name        String   @default("Combate")
  round       Int      @default(0)
  turnIndex   Int      @default(0)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  combatants  CombatCombatant[]

  @@index([campaignId])
}

model CombatCombatant {
  id          String   @id @default(cuid())
  encounterId String
  tokenId     String?
  characterId String?
  name        String
  initiative  Float    @default(0)
  order       Int      @default(0)
  hp          Int      @default(0)
  maxHp       Int      @default(0)
  conditions  Json     @default("[]")
  isNpc       Boolean  @default(false)

  encounter   CombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
}

// ---------------------------------------------------------------------------
// Bestiário / compêndio
// ---------------------------------------------------------------------------

model BestiaryEntry {
  id          String   @id @default(cuid())
  campaignId  String?  // null = entrada global/compartilhada
  kind        String   // "creature" | "npc" | "item" | "spell" | "ability"
  name        String
  system      String   @default("generic")
  data        Json     @default("{}")
  tags        String[] @default([])
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())

  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Auditoria
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}
