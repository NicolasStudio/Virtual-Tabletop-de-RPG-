# Copie para .env e ajuste. NUNCA comite .env com segredos reais.

# ---- Banco (Prisma) ----
DATABASE_URL="postgresql://tabletop:tabletop@localhost:5432/tabletop?schema=public"

# ---- API ----
PORT=3001
NODE_ENV=development
# origem permitida do front (CORS). Em prod use o domínio real.
WEB_ORIGIN="http://localhost:5173"

# ---- Auth (JWT) ----
# Gere segredos fortes: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET="troque-isto-em-producao-access"
JWT_REFRESH_SECRET="troque-isto-em-producao-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# ---- Cookies ----
COOKIE_SECURE=false        # true em produção (HTTPS)
COOKIE_DOMAIN=""           # ex.: .seudominio.com em prod

# ---- Redis (opcional, escala horizontal do Socket.IO) ----
REDIS_URL=""               # ex.: redis://localhost:6379 — vazio = desabilitado

# ---- Armazenamento de arquivos (S3-compatível) ----
# STORAGE_DRIVER=local|s3 — local salva em ./uploads (apenas dev)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./uploads"
S3_ENDPOINT=""             # ex.: https://s3.amazonaws.com ou MinIO
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false  # true para MinIO

# ---- Uploads ----
MAX_UPLOAD_MB=25

# ---- Front (Vite) — prefixo VITE_ é exposto ao browser ----
VITE_API_URL="http://localhost:3001"
VITE_SOCKET_URL="http://localhost:3001"
