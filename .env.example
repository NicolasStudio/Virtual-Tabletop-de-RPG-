# Copie para .env e ajuste. NUNCA comite .env com segredos reais.

# ---- Banco (Prisma) ----
DATABASE_URL="postgresql://tabletop:tabletop@localhost:5432/tabletop?schema=public"

# ---- API ----
PORT=3001
NODE_ENV=development
# origem permitida do front (CORS). Em prod use o domínio real.
WEB_ORIGIN="http://localhost:5173"

# ---- Auth (JWT) ----
# Gere segredos fortes: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET="troque-isto-em-producao-access"
JWT_REFRESH_SECRET="troque-isto-em-producao-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# ---- Login pela Ficha Ordem Paranormal (Firebase) ----
# Projeto do Firebase da Ficha: o Tabletop aceita o login feito lá (sem senha própria)
FIREBASE_PROJECT_ID="ficha-ordem-c31d7"
# Sites da Ficha que podem consultar /api/health para saber se o Tabletop está ligado
# (GitHub Pages e o Live Server do VS Code)
FICHA_ORIGINS="https://nicolasstudio.github.io,http://127.0.0.1:5500,http://localhost:5500"

# ---- Cookies ----
COOKIE_SECURE=false        # true em produção (HTTPS)
COOKIE_DOMAIN=""           # ex.: .seudominio.com em prod

# ---- Redis (opcional, escala horizontal do Socket.IO) ----
REDIS_URL=""               # ex.: redis://localhost:6379 — vazio = desabilitado

# ---- Armazenamento de arquivos (S3-compatível) ----
# STORAGE_DRIVER=local|s3 — local salva em ./uploads (apenas dev)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./uploads"
S3_ENDPOINT=""             # ex.: https://s3.amazonaws.com ou MinIO
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false  # true para MinIO

# ---- Uploads ----
MAX_UPLOAD_MB=25

# ---- Front (Vite) ----
# O app chama a API no mesmo endereço dele: o Vite repassa /api e /socket.io para
# a porta 3001 (apps/web/vite.config.ts). Assim basta publicar a porta 5173.
# Endereços públicos extras aceitos pelo Vite (além de *.trycloudflare.com):
TABLETOP_HOSTS=""          # ex.: mesa.seudominio.com
